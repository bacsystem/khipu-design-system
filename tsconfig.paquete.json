{
  // Compiles the publishable package (src/components + src/lib) to ESM + .d.ts in dist/.
  // Used by scripts/build-paquete.mjs; the demo app keeps using tsconfig.json (noEmit).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false,
    "allowJs": false,
    "target": "ES2020",
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "./dist",
    "plugins": []
  },
  "include": ["src/components/**/*.ts", "src/components/**/*.tsx", "src/lib/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/app"]
}

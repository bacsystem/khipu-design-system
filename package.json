{
  "name": "khipu-design-system",
  "version": "0.3.0",
  "private": true,
  "description": "Design system khipu: tokens, componentes y patrones para apps Next.js 15 + Tailwind v4 (React 19, base-ui, lucide).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bacsystem/khipu-design-system.git"
  },
  "type": "module",
  "bin": {
    "khipu-ds": "cli/khipu.mjs"
  },
  "files": [
    "dist",
    "cli",
    "registry",
    "src/components",
    "src/lib",
    "src/styles",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./theme.css": "./dist/styles/theme.css",
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./providers": {
      "types": "./dist/components/providers.d.ts",
      "default": "./dist/components/providers.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "default": "./dist/components/ui/*.js"
    },
    "./feedback/*": {
      "types": "./dist/components/feedback/*.d.ts",
      "default": "./dist/components/feedback/*.js"
    },
    "./formularios/*": {
      "types": "./dist/components/formularios/*.d.ts",
      "default": "./dist/components/formularios/*.js"
    },
    "./navegacion/*": {
      "types": "./dist/components/navegacion/*.d.ts",
      "default": "./dist/components/navegacion/*.js"
    },
    "./datos/*": {
      "types": "./dist/components/datos/*.d.ts",
      "default": "./dist/components/datos/*.js"
    },
    "./patrones/*": {
      "types": "./dist/components/patrones/*.d.ts",
      "default": "./dist/components/patrones/*.js"
    },
    "./nav/*": {
      "types": "./dist/components/nav/*.d.ts",
      "default": "./dist/components/nav/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint && npm run check:alturas",
    "check:alturas": "node scripts/verificar-alturas.mjs",
    "typecheck": "tsc --noEmit",
    "registry:build": "node scripts/build-registry.mjs",
    "build:paquete": "node scripts/build-paquete.mjs",
    "verify:paquete": "node scripts/build-paquete.mjs && node scripts/verificar-paquete.mjs",
    "prepare": "node scripts/build-paquete.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.8.0",
    "lucide-react": "^1.45.0",
    "next": "^15.5.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "lucide-react": "^1.45.0",
    "next": "15.5.25",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
